PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/powerpulse
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Set this to a Gemini model enabled for your project.
GEMINI_MODEL=gemini-3.6-flash

# SMTP is required for delivery of email verification codes in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="PowerPulse <your-email@example.com>"
